<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <table name="ict_withdrawal" resource="default" engine="innodb" comment="Withdrawal Requests">
        <column xsi:type="int" name="entity_id" identity="true" unsigned="true" nullable="false"/>
        <column xsi:type="varchar" name="order_number" nullable="false" length="50"/>
        <column xsi:type="varchar" name="email" nullable="false" length="255"/>
        <column xsi:type="varchar" name="token" nullable="false" length="255"/>
        <column xsi:type="varchar" name="status" nullable="false" length="20" default="pending"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
    </table>
</schema>